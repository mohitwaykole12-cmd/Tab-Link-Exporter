{
  "manifest_version": 3,
  "name": "Tab Link Exporter",
  "version": "1.0",
  "description": "Lists and exports all open tab URLs in the current window.",
  "permissions": [
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-16.png",
      "128": "icon-16.png"
    }
  }
}